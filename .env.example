# LM Phase 1 Free Deployment Configuration (0 EGP / $0, NO Credit Card!)
PORT=4000
NODE_ENV=production

# Auto-generated automatically if omitted (recommended to set a long random hex string on cloud hosts)
SESSION_SECRET=

# Optional: restrict allowed origins in production (leave * for instant friend testing)
CORS_ORIGIN=*

# Free Persistent Cloud DB Sync + 1GB Media Fallback via Supabase (NO credit card required!)
# Create a free project at https://supabase.com -> Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=lm-media
SUPABASE_STATE_BUCKET=lm-state

# Free 25GB/month Cloud Media CDN for Images, Videos & Voice Notes via Cloudinary (NO credit card required!)
# Create a free account at https://cloudinary.com -> Dashboard -> API Environment variable
CLOUDINARY_URL=
# Or set individual keys instead of CLOUDINARY_URL:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=lm

# Optional: custom local storage directories
LM_DATA_DIR=
LM_UPLOADS_DIR=

# Optional: AI Provider API keys (never commit real keys!)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
