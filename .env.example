# LM Phase 1 Free Deployment Configuration (0 EGP / $0)
PORT=4000
NODE_ENV=production

# Auto-generated automatically if omitted (recommended to set a long random hex string on cloud hosts)
SESSION_SECRET=

# Optional: restrict allowed origins in production (leave * for instant friend testing)
CORS_ORIGIN=*

# Optional: custom persistent directories (for Docker / Render / Oracle Free Tier volumes)
LM_DATA_DIR=
LM_UPLOADS_DIR=

# Optional: AI Provider API keys (never commit real keys!)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
